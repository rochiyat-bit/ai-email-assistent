# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/email_assistant"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="email_assistant"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_LOGGING="false"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-this-in-production"

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# AI Providers
ANTHROPIC_API_KEY="sk-ant-xxxxx"
OPENAI_API_KEY="sk-xxxxx"
OPENROUTER_API_KEY="sk-or-xxxxx"
AI_PROVIDER="anthropic"

# Redis Configuration (for BullMQ & Caching)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# Stripe Configuration (Subscription & Payments)
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
STRIPE_PRICE_ID_PRO_MONTHLY="price_xxxxx"
STRIPE_PRICE_ID_PRO_ANNUAL="price_xxxxx"
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY="price_xxxxx"
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL="price_xxxxx"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Email Assistant"
NODE_ENV="development"

# Email Service (for digest notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="AI Email Assistant <noreply@yourdomain.com>"

# Monitoring & Analytics
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Security
ENCRYPTION_KEY="your-32-byte-encryption-key-change-this"

# Feature Flags
ENABLE_AI_REPLY="true"
ENABLE_BATCH_PROCESSING="true"
MAX_EMAILS_PER_SYNC="100"
MAX_FREE_TRIAL_DAYS="7"
MAX_FREE_TRIAL_EMAILS="100"

# Logging
LOG_LEVEL="info"
